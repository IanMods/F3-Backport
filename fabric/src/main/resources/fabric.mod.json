{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/f3-backport",
    "sources": "${repoURL}",
    "issues": "${issueTrackerURL}"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "club.iananderson.f3backport.client.F3BackportClientFabric"
    ],
    "main": [
      "club.iananderson.f3backport.F3Backport"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabric-api": "*",
    "minecraft": "${fabric_version_range}",
    "java": ">=${java_version}",
    "fabric-key-binding-api-v1": "*",
    "forgeconfigapiport": "*"
  },
  "recommends": {
    "fabricloader": "~${fabric_loader_version}"
  }
}
  